# --- Amadeus Self-Service Flight Offers Search (Phase 1a data source) ---
# Sign up free at https://developers.amadeus.com -> "Self-Service" -> create an app.
# Test environment is a sandbox; switch AMADEUS_HOSTNAME to "production" with a production key when live.
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret
# "test" (sandbox, default) or "production"
AMADEUS_HOSTNAME=test

# --- Trip.com affiliate (monetization) ---
# These are public promo-link IDs (safe to commit defaults); override per-deployment if needed.
TRIP_ALLIANCE_ID=8815318
TRIP_SID=320696671
# Optional default region/currency for booking deep-links
TRIP_REGION=tw
TRIP_CURRENCY=TWD
