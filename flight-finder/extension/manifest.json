{
  "manifest_version": 3,
  "name": "Flight Finder — Skyscanner Interceptor",
  "version": "0.1.0",
  "description": "Phase 1b: capture Skyscanner flight search responses and relay them to the Flight Finder web app. Personal research helper.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.skyscanner.net/*",
    "https://*.skyscanner.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.skyscanner.net/*", "https://*.skyscanner.com/*"],
      "js": ["src/inject.main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.skyscanner.net/*", "https://*.skyscanner.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Flight Finder",
    "default_popup": "src/popup.html"
  }
}
